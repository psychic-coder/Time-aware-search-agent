# Copy to .env (repo root) and fill the two required keys.

# --- LLM (Meta Model API) ---
MODEL_API_KEY=                  # required: create one at https://dev.meta.ai
LLM_MODELS=muse-spark-1.3       # Meta Model API model
LLM_CONCURRENCY=2              # max in-flight LLM calls (process-wide)
LLM_RPM=18                     # token-bucket refill (requests/min). Free tier is roughly 20/min; limits change, tune here.
LLM_BASE_URL=https://api.meta.ai/v1
APP_URL=http://localhost:3000
APP_NAME=Time-Aware Search Agent

# --- Search (Tavily free tier) ---
TAVILY_API_KEY=                # required: https://app.tavily.com
SEARCH_MAX_CALLS_PER_REQUEST=12

# --- Server ---
PORT=4000
WEB_ORIGIN=http://localhost:3000   # CORS allow-origin for the web app
NEXT_PUBLIC_API_URL=http://localhost:4000   # read by the web app (Next.js loads this root .env)
LOG_LEVEL=info                 # debug | info | warn | error
