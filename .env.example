# Copy to .env (repo root) and fill the two required keys.

# --- LLM (OpenRouter; free DeepSeek models) ---
OPENROUTER_API_KEY=            # required: https://openrouter.ai/keys
LLM_MODELS=                 # optional: comma-separated override, e.g. deepseek/deepseek-chat-v3.1:free (skips /models discovery)
LLM_CONCURRENCY=2              # max in-flight LLM calls (process-wide)
LLM_RPM=18                     # token-bucket refill (requests/min). Free tier is roughly 20/min; limits change, tune here.
LLM_BASE_URL=https://openrouter.ai/api/v1   # swap to https://api.deepseek.com for the paid DeepSeek API (then set LLM_MODELS=deepseek-chat)
APP_URL=http://localhost:3000  # sent as HTTP-Referer to OpenRouter
APP_NAME=Time-Aware Search Agent   # sent as X-Title to OpenRouter

# --- Search (Tavily free tier) ---
TAVILY_API_KEY=                # required: https://app.tavily.com
SEARCH_MAX_CALLS_PER_REQUEST=12

# --- Server ---
PORT=4000
WEB_ORIGIN=http://localhost:3000   # CORS allow-origin for the web app
NEXT_PUBLIC_API_URL=http://localhost:4000   # read by the web app (Next.js loads this root .env)
LOG_LEVEL=info                 # debug | info | warn | error
